-        c.bytes.appendSlice(c.gpa, data) catch return error.Closed;
-        c.marks.append(c.gpa, .{ .end = c.bytes.items.len, .ns = std.Io.Clock.awake.now(io).toNanoseconds() }) catch return error.Closed;
-    }
-
-    fn deinit(c: *Capture) void {
