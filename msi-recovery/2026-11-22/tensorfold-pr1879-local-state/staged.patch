-        .agent => .{ .requests = 400, .system = 6144, .first = .{ .lo = 512, .hi = 4096 }, .turn = .{ .lo = 512, .hi = 4096 }, .reply = .{ .lo = 128, .hi = 1024 }, .cap = 131_072 },
