-/// The phase text a frame carries, read from the route's own event shape.
-fn pieces(frame: json.Value, route: Route, run: *Run, a: Allocator) !?Kind {
-    var kind: ?Kind = null;
-    switch (route) {
-        .chat => {
-            const choices = frame.get("choices") orelse return null;
