-    var next: i32 = 1;
-    const system = try gpa.alloc(i32, sh.system);
-    defer gpa.free(system);
-    for (system) |*t| {
-        t.* = next;
-        next += 1;
-    }
-    const convs = try gpa.alloc(Conv, sh.users);
