-        switch (s[i]) {
-            '"' => {
-                i += stringEnd(s[i..]) orelse return null;
-                if (depth == 0) return i;
-                continue;
-            },
-            '{', '[' => depth += 1,
-            '}', ']' => {
-                if (depth == 0) return i;
-                depth -= 1;
-                if (depth == 0) return i + 1;
