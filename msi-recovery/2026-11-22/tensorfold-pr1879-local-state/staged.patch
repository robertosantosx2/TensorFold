-def plan(turns_main=6):
-    out = [{"turn": i + 1, "kind": "main"} for i in range(turns_main)]
-    n = turns_main
-    out += [{"turn": n + 1, "kind": "raw-keep"}, {"turn": n + 2, "kind": "raw"}, {"turn": n + 3, "kind": "partial"}]
-    return out
