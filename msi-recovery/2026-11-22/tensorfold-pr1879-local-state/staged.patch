-        if (i == sh.requests / 2) half = b.now();
-        const u: u32 = switch (w) {
-            .agent, .chats => 0,
-            .mix => if (rnd.uintLessThan(u32, 100) < sh.hot_odds) rnd.uintLessThan(u32, sh.hot) else rnd.uintLessThan(u32, sh.users),
-        };
-        const c = &convs[u];
